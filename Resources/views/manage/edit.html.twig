{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}

{% block main %}
    {% set formEditTemplate = kimai_context.modalRequest ? 'default/_form_modal.html.twig' : 'default/_form.html.twig' %}
    {% set formOptions = {
        'title': (entity.id is null ? 'create'|trans : 'edit'|trans),
        'form': form,
        'back': path('manage_shared_project_timesheets')
    } %}
    {% embed formEditTemplate with formOptions %}
        {% block form_after %}
            <script type="text/javascript">
                (function () {
                    // the billable status is only relevant if non-billable entries are visible
                    const nonBillable = document.getElementById('{{ form.billableOptions.nonBillableVisible.vars.id }}');
                    const billable = document.getElementById('{{ form.billableOptions.entryBillableVisible.vars.id }}');
                    if (nonBillable === null || billable === null) {
                        return;
                    }
                    const billableRow = billable.closest('[data-customer-portal-billable-row]') ?? billable.parentElement;
                    const toggle = () => {
                        billableRow.style.display = nonBillable.checked ? '' : 'none';
                    };
                    nonBillable.addEventListener('change', toggle);
                    toggle();
                })();
            </script>
        {% endblock %}
    {% endembed %}
{% endblock %}
